; First-person player.
; CharacterBody3D → Head (Node3D, eye height 1.6 m)
;   → Camera3D → RayCast3D (3 m forward)
;              → HeldTapeVisual (VHS-shaped mesh shown when carrying tapes)
; CarryInventory  — holds up to 10 tapes; signals drive the HUD.
; PlacementSystem — shelf move / placement mode.
[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/player_controller.gd" id="1"]
[ext_resource type="Script" path="res://scripts/carry_inventory.gd"   id="2"]
[ext_resource type="Script" path="res://scripts/placement_system.gd"  id="3"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_1"]
radius = 0.40
height = 1.80

[sub_resource type="BoxMesh" id="BoxMesh_hand"]
size = Vector3(0.15, 0.10, 0.03)

[node name="Player" type="CharacterBody3D"]
script = ExtResource("1")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_1")

[node name="Head" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 0)

[node name="Camera3D" type="Camera3D" parent="Head"]

; Ray points 3 m along local -Z (straight ahead of the camera).
; collision_mask = 6 : layer 2 (tapes, value 2) + layer 3 (Area3D interaction zones, value 4)
; collide_with_areas = true so the ray detects shelf/counter/rewind Area3D nodes.
[node name="RayCast3D" type="RayCast3D" parent="Head/Camera3D"]
target_position = Vector3(0, 0, -3)
collision_mask = 6
collide_with_areas = true

; VHS-shaped hand preview — visible whenever the player is carrying tapes.
[node name="HeldTapeVisual" type="MeshInstance3D" parent="Head/Camera3D"]
transform = Transform3D(1, 0, 0, 0, 0.966, 0.259, 0, -0.259, 0.966, 0.3, -0.22, -0.50)
mesh = SubResource("BoxMesh_hand")
visible = false

; Carry inventory — up to 10 tapes.
[node name="CarryInventory" type="Node" parent="."]
script = ExtResource("2")

; Shelf placement / movement system.
[node name="PlacementSystem" type="Node" parent="."]
script = ExtResource("3")
