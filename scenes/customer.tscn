; Customer NPC — Node3D root with capsule body + sphere head.
; NavigationAgent3D handles pathfinding; customer.gd has a direct-movement
; fallback if the navmesh has not been baked yet.
[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/customer.gd" id="1"]

[sub_resource type="CapsuleMesh" id="CapsuleMesh_1"]
radius = 0.30
height = 1.20

[sub_resource type="StandardMaterial3D" id="Mat_body"]
albedo_color = Color(0.65, 0.45, 0.30, 1)

[sub_resource type="SphereMesh" id="SphereMesh_1"]
radius = 0.22
height = 0.44

[sub_resource type="StandardMaterial3D" id="Mat_head"]
albedo_color = Color(0.92, 0.75, 0.55, 1)

[node name="Customer" type="Node3D"]
script = ExtResource("1")

[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.60, 0)
mesh = SubResource("CapsuleMesh_1")
surface_material_override/0 = SubResource("Mat_body")

[node name="Head" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.55, 0)
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Mat_head")

; Speech-bubble label — billboard so it always faces the camera.
[node name="Label3D" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.10, 0)
text = ""
font_size = 30
pixel_size = 0.007
billboard = 1

; NavigationAgent3D drives pathfinding.  customer.gd falls back to direct
; movement if the NavigationRegion3D navmesh has not been baked.
[node name="NavigationAgent3D" type="NavigationAgent3D" parent="."]
path_desired_distance = 0.5
target_desired_distance = 0.8
