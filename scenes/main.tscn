; ─────────────────────────────────────────────────────────────────────────────
; Main scene — VHS Rewind: Video Store Simulator
;
; Node layout:
;   Main (Node3D / main.gd)
;     WorldEnvironment
;     DirectionalLight3D      ← warm overhead fill light
;     StoreEnvironment        ← store_setup.gd builds geometry procedurally
;     Shelves                 ← main.gd instances shelf.tscn here
;     Tapes                   ← main.gd instances tape.tscn here
;     SpawnPoints
;       CustomerSpawn (Z = +6.5)   ← entrance side
;       CustomerExit  (Z = +7.8)
;       CounterPoint  (Z = -2.8)   ← where customer stands at counter
;     Player                  ← starts behind the counter (Z = -5.5)
;     UI                      ← HUD (CanvasLayer)
;     CustomerSpawnTimer      ← one-shot timer; main.gd restarts it each cycle
; ─────────────────────────────────────────────────────────────────────────────
[gd_scene load_steps=7 format=3]

[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="1_player"]
[ext_resource type="PackedScene" path="res://scenes/ui.tscn"     id="2_ui"]
[ext_resource type="Script"      path="res://scripts/main.gd"          id="3_main"]
[ext_resource type="Script"      path="res://scripts/store_setup.gd"   id="4_setup"]

; Indoor environment: solid dark-brown background, warm ambient colour.
[sub_resource type="Environment" id="Env_1"]
background_mode        = 1
background_color       = Color(0.10, 0.08, 0.06, 1)
ambient_light_source   = 2
ambient_light_color    = Color(0.90, 0.85, 0.75, 1)
ambient_light_energy   = 0.40

[node name="Main" type="Node3D"]
script = ExtResource("3_main")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

; Directional light angled ~60° down from above — gives soft indoor shadows.
; Basis: Rx(-60°)  x=(1,0,0)  y=(0,0.5,-0.866)  z=(0,0.866,0.5)
[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform      = Transform3D(1, 0, 0, 0, 0.5, -0.866, 0, 0.866, 0.5, 0, 8, 0)
light_color    = Color(1, 0.96, 0.88, 1)
light_energy   = 0.60
shadow_enabled = false

[node name="StoreEnvironment" type="Node3D" parent="."]
script = ExtResource("4_setup")

[node name="Shelves" type="Node3D" parent="."]

[node name="Tapes" type="Node3D" parent="."]

[node name="SpawnPoints" type="Node3D" parent="."]

[node name="CustomerSpawn" type="Marker3D" parent="SpawnPoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 6.5)

[node name="CustomerExit" type="Marker3D" parent="SpawnPoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 7.8)

[node name="CounterPoint" type="Marker3D" parent="SpawnPoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -2.8)

; Player starts behind the counter, facing the entrance (+Z direction).
[node name="Player" parent="." instance=ExtResource("1_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, -5.5)

[node name="UI" parent="." instance=ExtResource("2_ui")]

; One-shot timer; main.gd sets wait_time and restarts it each customer cycle.
[node name="CustomerSpawnTimer" type="Timer" parent="."]
wait_time = 8.0
one_shot  = true
autostart = false
